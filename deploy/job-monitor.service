[Unit]
Description=SITAI JOB-Monitor - Monitoreo de Actividad y Asistencia Remota
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/JOB-Monitor/server
EnvironmentFile=/opt/JOB-Monitor/.env
ExecStart=/opt/JOB-Monitor/.venv/bin/python /opt/JOB-Monitor/server/app.py --host 0.0.0.0 --port 5080 --no-browser
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

