# ==============================================================================
# JOB-Monitor — Plantilla de Variables de Entorno (.env)
# Copia este archivo a ".env" y coloca tus contraseñas reales de producción.
# El archivo ".env" está bloqueado en .gitignore y NUNCA se sube a GitHub.
# ==============================================================================

RA_HOST=0.0.0.0
RA_PORT=5080
RA_TIMEZONE=America/Merida

# Credenciales del Panel de Administración Web
RA_ADMIN_USER=admin
RA_ADMIN_PASS=CambiaEstaClaveEnProduccion

# Token secreto compartido entre el Servidor y los Agentes Windows
RA_AGENT_TOKEN=CambiaEsteTokenSecretoEnProduccion

